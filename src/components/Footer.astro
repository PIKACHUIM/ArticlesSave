---
import {Icon} from "astro-icon/components";
import {USER_SITE, USER_FOOTER_SOCIAL_ICONS} from "@config";
---

<footer class="footer bg-base-100 p-10 rounded-xl shadow-lg">
    <aside>
        <p>
            如果未经声明，本站内容遵循CC-BY-NC-SA4及AGPL协议<br/>
            根据相关法律法规，本站不对欧盟地区的用户提供服务
        </p>
        <hr style="border: none; border-top: 1px solid currentColor; opacity: 0.2; margin:4px 0;"/>
        <p>
            WITHOUT DECLARATION, THE CONTENT OF THIS SITE IS<br>
            GOVERNED BY CC-BY-NC-SA-4 AND AFFERO GPL LICENSE<br>
            THIS SITE IS NOT AVAILABLE FOR EU VISITOR BY LAW
        </p>


    </aside>
    <nav>
        <span class="footer-title">Social / 联系我</span>
        <div class="grid grid-flow-col gap-4">
            {
                USER_FOOTER_SOCIAL_ICONS.map((icon) => (
                        <div class="tooltip" data-tip={icon.title}>
                            <a tabindex="0" href={icon.href} aria-label={icon.ariaLabel}>
                                <Icon name={icon.svg} class="text-2xl md:text-xl"/>
                            </a>
                        </div>
                ))
            }
            <div class="tooltip" data-tip="RSS Feed">
                <a tabindex="0" href="/rss.xml" aria-label="RSS Feed">
                    <Icon name="ri:rss-line" class="text-2xl md:text-xl"/>
                </a>
            </div>
            Powered by <a href="https://github.com/EveSunMaple/Ryuchan" target="_blank"
                          class="font-bold">Ryuchan</a>
        </div>
        <p>
            Copyright ©{new Date().getFullYear()} 皮卡丘的静态归档博客<br/>
            Copyright ©{new Date().getFullYear()} Pikachu Archive Blog<br/>
            ALL RIGHTS RESERVED / 保留所有的权利
        </p>
    </nav>
</footer>
