---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import MainCard from "@/components/MainCard.astro";
import FriendCard from "@/components/mdx/FriendCard.astro";
---

<BaseLayout title="Projects">
  <MainCard
    infoIcon="lucide:code-2"
  >
    <!-- 皮卡工具 -->
    <section class="py-4">
      <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
        <Icon name="lucide:wrench" class="w-6 h-6 text-primary" />
        <span>皮卡工具</span>
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <FriendCard
              name="AI在线聊天"
              avatar="https://aichat.524228.xyz/favicon.ico"
              description="🤖 智能AI对话工具，支持多种模型"
              url="https://aichat.524228.xyz"
              type="friend"
        />
        <FriendCard
              name="AI在线画图"
              avatar="https://aidraw.524228.xyz/favicon.ico"
              description="🎨 AI图像生成工具，文字转图片"
              url="https://aidraw.524228.xyz"
              type="friend"
        />
        <FriendCard
              name="EasyTier节点共享"
              avatar="https://etpage.524228.xyz/favicon.ico"
              description="🌐 EasyTier节点共享平台"
              url="https://etpage.524228.xyz"
              type="friend"
        />
        <FriendCard
              name="BitWarden托管"
              avatar="https://valuts.524228.xyz/favicon.ico"
              description="🔐 BitWarden三方托管平台，存储密码和敏感信息"
              url="https://valuts.524228.xyz"
              type="friend"
        />
        <FriendCard
              name="Docker代理"
              avatar="https://docker.524228.xyz/favicon.ico"
              description="🐳 Docker镜像代理服务"
              url="https://docker.524228.xyz"
              type="friend"
        />
        <FriendCard
              name="Github代理"
              avatar="https://github.524228.xyz/favicon.ico"
              description="🐙 GitHub访问代理服务"
              url="https://github.524228.xyz"
              type="friend"
        />
        <FriendCard
              name="DoH代理服务"
              avatar="https://dnspod.524228.xyz/favicon.ico"
              description="🛡️ 安全、快速的DNS解析服务"
              url="https://dnspod.524228.xyz"
              type="friend"
        />
        <FriendCard
              name="IT工具集合"
              avatar="https://ittool.524228.xyz/favicon.ico"
              description="🧰 各种IT实用工具合集"
              url="https://ittool.524228.xyz"
              type="friend"
        />
        <FriendCard
              name="皮卡代码站"
              avatar="https://coding.524228.xyz/favicon.ico"
              description="💻 代码分享与博客平台"
              url="https://coding.524228.xyz"
              type="friend"
        />
        <FriendCard
              name="订阅生成器"
              avatar="https://scribe.524228.xyz/favicon.ico"
              description="📡 生成各种订阅链接"
              url="https://scribe.524228.xyz"
              type="friend"
        />
        <FriendCard
              name="在线证书站"
              avatar="https://newssl.524228.xyz/favicon.ico"
              description="🔒 SSL证书管理工具"
              url="https://newssl.524228.xyz"
              type="friend"
        />
        <FriendCard
              name="临时邮箱站"
              avatar="https://mailer.524228.xyz/favicon.ico"
              description="📧 临时邮箱服务"
              url="https://mailer.524228.xyz"
              type="friend"
        />
        <FriendCard
              name="图片处理站"
              avatar="https://photon.524228.xyz/favicon.ico"
              description="🖼️ 在线图片处理工具"
              url="https://photon.524228.xyz"
              type="friend"
        />
        <FriendCard
              name="PS在线使用"
              avatar="https://paints.524228.xyz/favicon.ico"
              description="🎭 在线Photoshop工具"
              url="https://paints.524228.xyz"
              type="friend"
        />
        <FriendCard
              name="在线剪贴板"
              avatar="https://paster.524228.xyz/favicon.ico"
              description="📋 在线剪贴板服务"
              url="https://paster.524228.xyz"
              type="friend"
        />
        <FriendCard
              name="音乐解锁平台"
              avatar="https://unlock.524228.xyz/favicon.ico"
              description="🎵 一键去除音乐加密"
              url="https://unlock.524228.xyz"
              type="friend"
        />
        <FriendCard
              name="IP地址查看"
              avatar="https://ipaddr.524228.xyz/favicon.ico"
              description="🌍 查看当前IP地址"
              url="https://ipaddr.524228.xyz"
              type="friend"
        />
        <FriendCard
              name="Onedrive站"
              avatar="https://onecdn.524228.xyz/favicon.ico"
              description="☁️ OneDrive文件管理"
              url="https://onecdn.524228.xyz"
              type="friend"
        />
      </div>
    </section>

    <!-- 开源项目 -->
    <section class="py-4">
      <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
        <Icon name="lucide:folder-git-2" class="w-6 h-6 text-primary" />
        <span>开源项目</span>
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <FriendCard
              name="WebIndex"
              avatar="https://github.githubassets.com/favicons/favicon.svg"
              description="🏠 现代化导航网站，Cloudflare Worker部署"
              url="https://github.com/PIKACHUIM/WebIndex"
              type="friend"
        />
        <FriendCard
              name="RDDocker"
              avatar="https://github.githubassets.com/favicons/favicon.svg"
              description="🐳 Docker相关工具和配置"
              url="https://github.com/PIKACHUIM/RDDocker"
              type="friend"
        />
        <FriendCard
              name="FreeSSL"
              avatar="https://github.githubassets.com/favicons/favicon.svg"
              description="🔒 免费SSL证书自动申请工具"
              url="https://github.com/PIKACHUIM/FreeSSL"
              type="friend"
        />
        <FriendCard
              name="TestCA"
              avatar="https://github.githubassets.com/favicons/favicon.svg"
              description="🏛️ 测试证书颁发机构"
              url="https://github.com/PIKACHUIM/TestCA"
              type="friend"
        />
        <FriendCard
              name="DockerProxy"
              avatar="https://github.githubassets.com/favicons/favicon.svg"
              description="🐋 Docker镜像代理服务源码"
              url="https://github.com/PIKACHUIM/DockerProxy"
              type="friend"
        />
        <FriendCard
              name="GithubProxy"
              avatar="https://github.githubassets.com/favicons/favicon.svg"
              description="🐙 GitHub访问代理服务源码"
              url="https://github.com/PIKACHUIM/GithubProxy"
              type="friend"
        />
      </div>

      <div class="flex justify-center mt-10">
        <a
          href="https://github.com/PIKACHUIM?tab=repositories"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline gap-2"
        >
          <Icon name="lucide:github" class="w-5 h-5" />
          <span>View More on GitHub</span>
        </a>
      </div>
    </section>

    
  </MainCard>
</BaseLayout>
